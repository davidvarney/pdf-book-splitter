{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Book Splitter",
  "version": "0.1.0",
  "identifier": "dev.davidvarney.pdfbooksplitter",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev -w apps/web",
      "cwd": "../../.."
    },
    "beforeBuildCommand": {
      "script": "npm run build -w apps/web",
      "cwd": "../../.."
    },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PDF Book Splitter",
        "width": 900,
        "height": 720,
        "minWidth": 480,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
